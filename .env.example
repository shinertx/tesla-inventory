# Pending dealer onboarding: browsing and free purchase requests only.
PUBLIC_ORIGIN=http://127.0.0.1:8000
ADMIN_TOKEN=
SOURCING_JSON=.data/source_snapshot.json
PLATFORM_AGREEMENTS_VERIFIED=false
SUPPORTED_STATES=
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MIN_CONTRIBUTION_CENTS=100000
REQUEST_RETENTION_DAYS=90

# Market-reference retail by default. Optional discount for measured pricing experiments.
# No spread ceiling. Asking-price comparisons do not establish achievable sale prices.
BUYER_SAVINGS_CENTS=0

# Embedded reservation checkout stays within the marketplace. Keys must share test/live mode.
STRIPE_PUBLISHABLE_KEY=
CHECKOUT_UI_MODE=embedded_page
